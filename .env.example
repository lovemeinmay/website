# Copy this file to .env for testing on your own computer.
# On Render, add these under your service's Environment tab instead.

# Shown on the site and used as the start of every license key (RAIN-XXXXX-XXXXX-XXXXX).
SITE_NAME=RAIN

# Any long random string (at least 16 characters). Keeps logins secure.
SESSION_SECRET=

# From https://discord.com/developers/applications -> your app -> OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect in the Discord app. On Render: https://YOUR-APP.onrender.com/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Your Discord user ID. Separate several with commas for co-admins.
ADMIN_DISCORD_IDS=

# Optional. If set, the Roblox script must send it in an X-License-Token header.
PUBLIC_API_TOKEN=

# Optional. Your site's address, used inside the loader. Worked out from DISCORD_REDIRECT_URI if blank.
PUBLIC_URL=

# How long users must wait before switching to a different Roblox account (hours). 0 = no wait.
ROBLOX_RELINK_COOLDOWN_HOURS=168

# From https://turso.tech. Leave blank locally to use a data.db file instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# On Render, also set NODE_ENV=production. Leave it out locally, or login breaks on http://localhost.
